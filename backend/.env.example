# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=incident_management
DB_USERNAME=incident_app
DB_PASSWORD=change_me_locally

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# API server
SERVER_PORT=8080

# JWT (use a long random secret in real environments; minimum 32 characters for HS256)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_DAYS=7
AUTH_REFRESH_COOKIE_SECURE=false
